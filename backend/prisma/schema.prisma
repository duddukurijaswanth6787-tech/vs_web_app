  createdAt      DateTime        @default(now())
  referee        CustomerProfile @relation("ReferralRedeemer", fields: [refereeId], references: [id], onDelete: Cascade)
  referralCode   ReferralCode    @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@unique([referralCodeId, refereeId])
  @@index([refereeId])
  @@map("referral_redemptions")
}

model RecentlyViewedProduct {
