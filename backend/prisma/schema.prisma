/// A reusable set of body measurements per size, attached to many products so
/// the numbers are entered once per garment shape rather than per product.
model SizeChartTemplate {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  /// Kurta, Saree Blouse, Lehenga … — what shape this chart describes.
  garmentType String?
  /// Measurement unit the rows are expressed in.
  unit        String           @default("inch")
  status      String           @default("ACTIVE")
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rows        SizeChartRow[]
  products    Product[]

  @@index([status])
  @@map("size_chart_templates")
}

/// One size within a template, e.g. M -> { bust: 38, waist: 34, hip: 40 }.
model SizeChartRow {
  id           String            @id @default(uuid())
  templateId   String
  size         String
  /// Measurement name -> value, so different garment shapes can carry
  /// different fields without a schema change.
  measurements Json
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  template     SizeChartTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, size])
  @@index([templateId])
  @@map("size_chart_rows")
}
