generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  phone                   String?
  passwordHash            String
  googleId                String?                  @unique
  userType                UserType                 @default(CUSTOMER)
  accountStatus           AccountStatus            @default(PENDING_VERIFICATION)
  gender                  Gender?
  firstName               String
  lastName                String?
  avatar                  String?
  language                String                   @default("en")
  country                 String                   @default("IN")
  lastLoginAt             DateTime?
  loginAttempts           Int                      @default(0)
  lockoutUntil            DateTime?
  isEmailVerified         Boolean                  @default(false)
  isPhoneVerified         Boolean                  @default(false)
  metadata                Json?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  aiConversations         AiConversation[]
  aiFeedback              AiFeedback[]
  customerProfile         CustomerProfile?
  emailVerificationTokens EmailVerificationToken[]
  notificationPreference  NotificationPreference?
  notifications           Notification[]
  otpChallenges           OtpChallenge[]
  passwordResetTokens     PasswordResetToken[]
  prescriptions           Prescription[]
  pushDevices             PushDevice[]
  pushLogs                PushNotificationLog[]
  recommendationHistory   RecommendationHistory[]
  refreshTokens           RefreshToken[]
  emailLogs               EmailLog[]
  reviewReports           ReviewReport[]
  reviewVotes             ReviewVote[]
  searchHistory           SearchHistory[]
  smsLogs                 SmsLog[]
  socialBookmarks         SocialBookmark[]
  socialComments          SocialComment[]
  socialLikes             SocialLike[]
  socialPosts             SocialPost[]             @relation("SocialPostAuthor")
  socialReportsReporter   SocialReport[]           @relation("SocialReportReporter")
  socialReportsReviewer   SocialReport[]           @relation("SocialReportReviewer")
  socialShares            SocialShare[]
  socialViews             SocialView[]
  createdStaff            StaffProfile[]           @relation("StaffCreatedBy")
  staffProfile            StaffProfile?
  userRoles               UserRole[]
  checkoutSessions        CheckoutSession[]        @relation("CheckoutSessionCashier")
  posShifts               PosShift[]

  @@index([deletedAt])
  @@index([accountStatus])
  @@index([phone])
  @@map("users")
}

model StaffProfile {
  id                 String           @id @default(uuid())
  userId             String           @unique
  department         StaffDepartment
  designation        StaffDesignation
  employeeId         String           @unique
  joinedAt           DateTime?
  createdBy          String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  address            String?
  emergencyContact   String?
  employmentStatus   String           @default("ACTIVE")
  jobTitle           String?
  profileImage       String?
  reportingManagerId String?
  creator            User             @relation("StaffCreatedBy", fields: [createdBy], references: [id])
  reportingManager   StaffProfile?    @relation("StaffReportsTo", fields: [reportingManagerId], references: [id])
  reports            StaffProfile[]   @relation("StaffReportsTo")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([employmentStatus])
  @@index([reportingManagerId])
  @@map("staff_profiles")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  displayName     String
  description     String?
  scope           RoleScope        @default(DOMAIN)
  hierarchy       Int              @default(0)
  isSystem        Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  module          String
  scope           PermissionScope  @default(MODULE)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id             String        @id @default(uuid())
  token          String        @unique
  userId         String
  userAgent      String?
  ipAddress      String?
  loginProvider  LoginProvider @default(LOCAL)
  expiresAt      DateTime
  lastActivityAt DateTime      @default(now())
  isRevoked      Boolean       @default(false)
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  staffId       String?
  action        String
  module        String
  resource      String
  resourceId    String?
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  requestId     String?
  correlationId String?
  status        String   @default("SUCCESS")
  message       String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@index([staffId])
  @@index([status])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Category {
  id                String              @id @default(uuid())
  name              String
  slug              String              @unique
  description       String?
  icon              String?
  image             String?
  bannerImage       String?
  parentId          String?
  level             Int                 @default(0)
  path              String              @default("")
  displayOrder      Int                 @default(0)
  isFeatured        Boolean             @default(false)
  isVisible         Boolean             @default(true)
  isMenuVisible     Boolean             @default(true)
  seoTitle          String?
  seoDescription    String?
  seoKeywords       String?
  status            String              @default("ACTIVE")
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  parent            Category?           @relation("CategoryParent", fields: [parentId], references: [id])
  children          Category[]          @relation("CategoryParent")
  attributeMappings CategoryAttribute[]
  homepageMappings  HomepageCategory[]
  productMappings   ProductCategory[]

  @@index([parentId])
  @@index([level])
  @@index([path])
  @@index([status])
  @@index([isFeatured])
  @@index([isVisible])
  @@index([isMenuVisible])
  @@index([deletedAt])
  @@index([displayOrder])
  @@map("categories")
}

model Brand {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  description    String?
  logo           String?
  bannerImage    String?
  website        String?
  isFeatured     Boolean   @default(false)
  isVisible      Boolean   @default(true)
  displayOrder   Int       @default(0)
  status         String    @default("ACTIVE")
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@index([deletedAt])
  @@index([status])
  @@index([isFeatured])
  @@index([isVisible])
  @@map("brands")
}

model AttributeGroup {
  id           String      @id @default(uuid())
  name         String
  slug         String      @unique
  description  String?
  displayOrder Int         @default(0)
  status       String      @default("ACTIVE")
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  attributes   Attribute[]

  @@index([deletedAt])
  @@index([status])
  @@map("attribute_groups")
}

model Attribute {
  id               String                  @id @default(uuid())
  groupId          String
  name             String
  slug             String
  type             String
  description      String?
  displayOrder     Int                     @default(0)
  isRequired       Boolean                 @default(false)
  isFilterable     Boolean                 @default(false)
  isSearchable     Boolean                 @default(false)
  isComparable     Boolean                 @default(false)
  isVariant        Boolean                 @default(false)
  status           String                  @default("ACTIVE")
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  usesSwatch       Boolean                 @default(false)
  options          AttributeOption[]
  group            AttributeGroup          @relation(fields: [groupId], references: [id])
  categoryMappings CategoryAttribute[]
  productValues    ProductAttribute[]
  variantValues    VariantAttributeValue[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@index([type])
  @@index([status])
  @@index([deletedAt])
  @@map("attributes")
}

model AttributeOption {
  id             String                  @id @default(uuid())
  attributeId    String
  value          String
  label          String
  metadata       Json?
  displayOrder   Int                     @default(0)
  status         String                  @default("ACTIVE")
  deletedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  swatchImageUrl String?
  attribute      Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  colorGroups    ProductColorGroup[]
  variantValues  VariantAttributeValue[]

  @@index([attributeId])
  @@index([value])
  @@index([deletedAt])
  @@map("attribute_options")
}

model CategoryAttribute {
  categoryId   String
  attributeId  String
  displayOrder Int       @default(0)
  isRequired   Boolean   @default(false)
  isFilterable Boolean   @default(false)
  isSearchable Boolean   @default(false)
  isComparable Boolean   @default(false)
  isVariant    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  attribute    Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@index([categoryId])
  @@index([attributeId])
  @@map("category_attributes")
}

model Product {
  id                      String                   @id @default(uuid())
  sku                     String                   @unique
  barcode                 String                   @unique
  name                    String
  slug                    String                   @unique
  shortDescription        String?
  description             String?
  brandId                 String
  type                    String                   @default("READYMADE")
  status                  String                   @default("DRAFT")
  visibility              String                   @default("VISIBLE")
  basePrice               Decimal
  salePrice               Decimal?
  wholesalePrice          Decimal?
  costPrice               Decimal?
  taxPercentage           Decimal?                 @default(0)
  discountType            String?
  discountValue           Decimal?
  trackInventory          Boolean                  @default(true)
  allowBackorder          Boolean                  @default(false)
  minimumOrderQuantity    Int                      @default(1)
  maximumOrderQuantity    Int                      @default(0)
  weight                  Decimal?
  length                  Decimal?
  width                   Decimal?
  height                  Decimal?
  isFeatured              Boolean                  @default(false)
  isNewArrival            Boolean                  @default(false)
  isBestSeller            Boolean                  @default(false)
  isPublished             Boolean                  @default(false)
  publishedAt             DateTime?
  displayOrder            Int                      @default(0)
  seoTitle                String?
  seoDescription          String?
  seoKeywords             String?
  canonicalUrl            String?
  searchKeywords          String?
  gender                  String?
  ageGroup                String?
  occasion                String?
  season                  String?
  tags                    String[]
  collections             String[]
  createdBy               String?
  updatedBy               String?
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  highlights              String[]
  isTrending              Boolean                  @default(false)
  taxInclusive            Boolean                  @default(true)
  hsnCode                 String?
  sizeChartTemplateId     String?
  isLimitedStock          Boolean                  @default(false)
  isFestivePick           Boolean                  @default(false)
  isExclusive             Boolean                  @default(false)
  isOnlineOnly            Boolean                  @default(false)
  channel                 String                   @default("BOTH")
  // Weighted tsvector (name/description/keywords/sku/tags) kept in sync by a
  // DB trigger (products_search_vector_trigger, see the migration), never
  // written to from application code. Read directly via $queryRaw in
  // SearchRepository for full-text relevance ranking.
  searchVector            Unsupported("tsvector")?
  sizeChartTemplate       SizeChartTemplate?       @relation(fields: [sizeChartTemplateId], references: [id])
  customerRecommendations CustomerRecommendation[]
  orderItems              OrderItem[]
  prescriptionMedicines   PrescriptionMedicine[]
  attributeValues         ProductAttribute[]
  categories              ProductCategory[]
  colorGroups             ProductColorGroup[]
  media                   ProductMedia[]
  relatedTo               ProductRelatedProduct[]  @relation("ProductRelatedTo")
  relatedFrom             ProductRelatedProduct[]  @relation("ProductRelatedFrom")
  variants                ProductVariant[]
  brand                   Brand                    @relation(fields: [brandId], references: [id])
  recentlyViewed          RecentlyViewedProduct[]
  reviews                 Review[]
  cartItems               ShoppingCartItem[]
  socialPosts             SocialPostProduct[]
  wishlistItems           WishlistItem[]

  @@index([brandId])
  @@index([status])
  @@index([visibility])
  @@index([type])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isBestSeller])
  @@index([isTrending])
  @@index([channel])
  @@index([isPublished])
  @@index([gender])
  @@index([ageGroup])
  @@index([occasion])
  @@index([season])
  @@index([basePrice])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([isPublished, visibility, deletedAt])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductAttribute {
  productId   String
  attributeId String
  value       String?
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
  @@map("product_attributes")
}

model ProductRelatedProduct {
  productId        String
  relatedProductId String
  product          Product @relation("ProductRelatedTo", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product @relation("ProductRelatedFrom", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([productId])
  @@index([relatedProductId])
  @@map("product_related_products")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model ProductVariant {
  id                String                      @id @default(uuid())
  productId         String
  sku               String                      @unique
  barcode           String                      @unique
  title             String
  priceOverride     Decimal?
  salePriceOverride Decimal?
  costPrice         Decimal?
  weight            Decimal?
  length            Decimal?
  width             Decimal?
  height            Decimal?
  displayOrder      Int                         @default(0)
  status            String                      @default("ACTIVE")
  isDefault         Boolean                     @default(false)
  isActive          Boolean                     @default(true)
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  colorGroupId      String?
  inventory         Inventory?
  orderItems        OrderItem[]
  media             ProductMedia[]
  colorGroup        ProductColorGroup?          @relation(fields: [colorGroupId], references: [id])
  product           Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems         ShoppingCartItem[]
  socialPosts       SocialPostProduct[]
  attributeValues   VariantAttributeValue[]
  warehouseStock    VariantWarehouseInventory[]
  wishlistItems     WishlistItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@index([colorGroupId])
  @@index([status])
  @@index([isActive])
  @@index([isDefault])
  @@index([deletedAt])
  @@map("product_variants")
}

model ProductColorGroup {
  id                     String           @id @default(uuid())
  productId              String
  colorAttributeOptionId String
  label                  String?
  sortOrder              Int              @default(0)
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  colorAttributeOption   AttributeOption  @relation(fields: [colorAttributeOptionId], references: [id])
  product                Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  media                  ProductMedia[]
  variants               ProductVariant[]

  @@unique([productId, colorAttributeOptionId])
  @@index([productId])
  @@index([colorAttributeOptionId])
  @@map("product_color_groups")
}

model VariantAttributeValue {
  id                String           @id @default(uuid())
  variantId         String
  attributeId       String
  attributeOptionId String?
  value             String?
  attribute         Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option            AttributeOption? @relation(fields: [attributeOptionId], references: [id])
  variant           ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeId])
  @@index([variantId])
  @@index([attributeId])
  @@index([attributeOptionId])
  @@map("variant_attribute_values")
}

model Inventory {
  id                String              @id @default(uuid())
  variantId         String              @unique
  availableQuantity Int                 @default(0)
  reservedQuantity  Int                 @default(0)
  damagedQuantity   Int                 @default(0)
  returnedQuantity  Int                 @default(0)
  minimumStock      Int                 @default(0)
  maximumStock      Int                 @default(0)
  reorderLevel      Int                 @default(0)
  stockStatus       String              @default("OUT_OF_STOCK")
  allowBackorder    Boolean             @default(false)
  trackInventory    Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  variant           ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements         InventoryMovement[]

  @@index([stockStatus])
  @@map("inventory")
}

model InventoryMovement {
  id               String    @id @default(uuid())
  inventoryId      String
  variantId        String
  movementType     String
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  referenceType    String?
  referenceId      String?
  reason           String?
  remarks          String?
  performedBy      String?
  createdAt        DateTime  @default(now())
  inventory        Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([variantId])
  @@index([movementType])
  @@index([createdAt])
  @@map("inventory_movements")
}

model Warehouse {
  id            String                      @id @default(uuid())
  code          String                      @unique
  name          String
  description   String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  contactPerson String?
  phone         String?
  email         String?
  status        String                      @default("ACTIVE")
  isDefault     Boolean                     @default(false)
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  inventories   VariantWarehouseInventory[]
  locations     WarehouseLocation[]

  @@index([status])
  @@index([deletedAt])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String    @id @default(uuid())
  warehouseId String
  zone        String?
  rack        String?
  shelf       String?
  bin         String?
  description String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@map("warehouse_locations")
}

model VariantWarehouseInventory {
  id                String         @id @default(uuid())
  warehouseId       String
  variantId         String
  availableQuantity Int            @default(0)
  reservedQuantity  Int            @default(0)
  damagedQuantity   Int            @default(0)
  minimumStock      Int            @default(0)
  maximumStock      Int            @default(0)
  reorderLevel      Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
  @@index([warehouseId])
  @@index([variantId])
  @@map("variant_warehouse_inventory")
}

model ProductMedia {
  id           String             @id @default(uuid())
  productId    String
  variantId    String?
  mediaType    String
  title        String?
  altText      String?
  url          String
  thumbnailUrl String?
  displayOrder Int                @default(0)
  isPrimary    Boolean            @default(false)
  status       String             @default("ACTIVE")
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  color        String?
  colorGroupId String?
  colorGroup   ProductColorGroup? @relation(fields: [colorGroupId], references: [id])
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant?    @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([colorGroupId])
  @@index([variantId])
  @@index([mediaType])
  @@index([isPrimary])
  @@index([deletedAt])
  @@map("product_media")
}

model MediaFolder {
  id          String        @id @default(uuid())
  name        String
  parentId    String?
  description String?
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  media       Media[]
  parent      MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    MediaFolder[] @relation("FolderHierarchy")

  @@index([parentId])
  @@index([createdBy])
  @@map("media_folders")
}

model Media {
  id               String       @id @default(uuid())
  filename         String
  originalFilename String
  mimeType         String
  extension        String
  size             Int
  width            Int?
  height           Int?
  duration         Decimal?
  folderId         String?
  altText          String?
  caption          String?
  checksum         String?
  storageProvider  String       @default("s3")
  storageKey       String
  publicUrl        String
  thumbnailUrl     String?
  mediumUrl        String?
  largeUrl         String?
  uploadedBy       String?
  isDeleted        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  folder           MediaFolder? @relation(fields: [folderId], references: [id])

  @@index([folderId])
  @@index([mimeType])
  @@index([checksum])
  @@index([uploadedBy])
  @@index([isDeleted])
  @@index([createdAt])
  @@map("media")
}

model CustomerProfile {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique
  phone                   String?
  gender                  String?
  dateOfBirth             DateTime?
  preferredLanguage       String                   @default("en")
  preferredCurrency       String                   @default("INR")
  preferredCategories     String[]
  preferredBrands         String[]
  preferredSizes          String[]
  preferredColors         String[]
  preferredPriceMin       Decimal?
  preferredPriceMax       Decimal?
  profileImage            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  addresses               CustomerAddress[]
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerRecommendations CustomerRecommendation[]
