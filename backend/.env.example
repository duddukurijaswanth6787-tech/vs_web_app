# Application
NODE_ENV=production
PORT=4000
HOSTNAME=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vasanthi_designers?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (REQUIRED in production - min 16 chars)
JWT_SECRET=change-this-to-a-secure-secret-key-at-least-16-chars
JWT_EXPIRES_IN=900
JWT_REMEMBER_ME_EXPIRES_IN=2592000
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
JWT_ISSUER=vasanthi-designers

# CORS (REQUIRED in production)
CORS_ORIGIN=https://yourdomain.com

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Security
TRUST_PROXY_COUNT=1
BODY_JSON_LIMIT=2mb
BODY_URLENCODED_LIMIT=2mb

# Storage Provider (s3 for production)
STORAGE_PROVIDER=s3
STORAGE_MAX_FILE_SIZE=10485760
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif,application/pdf,video/mp4

# AWS S3 (REQUIRED in production)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_URL=https://your-bucket-name.s3.amazonaws.com
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_SIGNED_URL_EXPIRY=3600

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
ENABLE_RAZORPAY=true
PAYMENT_PROVIDER=razorpay

# Monitoring
ENABLE_MONITORING=true
MONITORING_SLOW_REQUEST_THRESHOLD=1000
SLOW_QUERY_THRESHOLD=1000

# Features
ENABLE_SWAGGER=false
ENABLE_REDIS=true
ENABLE_BULLMQ=true
ENABLE_LOGGER=true

# HTTP Logging
HTTP_LOG_ENABLED=true
HTTP_LOG_REQUEST_BODY=true
HTTP_LOG_RESPONSE_BODY=true
HTTP_LOG_MAX_BODY_LENGTH=10000
HTTP_LOG_HEALTH_REQUESTS=false

# RAG & LLM Configuration
RAG_ENABLED=true
RAG_LLM_PROVIDER=gemini
RAG_EMBEDDING_PROVIDER=gemini
RAG_DEFAULT_AGENT_KEY=customer_support_agent
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=8
RAG_MIN_RELEVANCE_SCORE=0.65
RAG_MAX_CONTEXT_CHUNKS=6
RAG_CONVERSATION_HISTORY_LIMIT=12
RAG_TOOL_MAX_EXECUTIONS=5
RAG_REQUEST_TIMEOUT_MS=30000
RAG_MAX_MESSAGE_LENGTH=4000
RAG_URL_FETCH_TIMEOUT_MS=10000
RAG_URL_MAX_REDIRECTS=3
RAG_URL_MAX_CONTENT_BYTES=5242880

GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

