generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN

  @@map("user_type")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
  PENDING_VERIFICATION
  DELETED

  @@map("account_status")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum LoginProvider {
  LOCAL
  GOOGLE
  FACEBOOK

  @@map("login_provider")
}

enum RoleScope {
  GLOBAL
  DOMAIN
  CUSTOM

  @@map("role_scope")
}

enum PermissionScope {
  GLOBAL
  MODULE
  DOMAIN
  SELF

  @@map("permission_scope")
}

enum StaffDepartment {
  MANAGEMENT
  SALES
  MARKETING
  WAREHOUSE
  PACKING
  CUSTOMER_SUPPORT
  INVENTORY
  ACCOUNTING
  IT

  @@map("staff_department")
}

enum StaffDesignation {
  MANAGER
  SUPERVISOR
  EXECUTIVE
  ASSOCIATE
  TRAINEE

  @@map("staff_designation")
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  phone             String?
  passwordHash      String
  userType          UserType      @default(CUSTOMER)
  accountStatus     AccountStatus @default(PENDING_VERIFICATION)
  gender            Gender?
  firstName         String
  lastName          String?
  avatar            String?
  language          String        @default("en")
  country           String        @default("IN")
  lastLoginAt       DateTime?
  loginAttempts     Int           @default(0)
  lockoutUntil      DateTime?
  isEmailVerified   Boolean       @default(false)
  isPhoneVerified   Boolean       @default(false)
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  staffProfile      StaffProfile?
  userRoles         UserRole[]
  refreshTokens     RefreshToken[]
  createdStaff           StaffProfile[]       @relation("StaffCreatedBy")
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  customerProfile   CustomerProfile?
  notifications     Notification[]
  notificationPreference NotificationPreference?
  reviewVotes       ReviewVote[]
  aiConversations   AiConversation[]
  prescriptions     Prescription[]
  recommendationHistory RecommendationHistory[]
  searchHistory     SearchHistory[]
  aiFeedback        AiFeedback[]

  @@index([deletedAt])
  @@index([accountStatus])
  @@map("users")
}

model StaffProfile {
  id                  String          @id @default(uuid())
  userId              String          @unique
  department          StaffDepartment
  designation         StaffDesignation
  employeeId          String          @unique
  jobTitle            String?
  reportingManagerId  String?
  joinedAt            DateTime?
  employmentStatus    String          @default("ACTIVE")
  emergencyContact    String?
  address             String?
  profileImage        String?
  createdBy           String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator           User          @relation("StaffCreatedBy", fields: [createdBy], references: [id])
  reportingManager  StaffProfile? @relation("StaffReportsTo", fields: [reportingManagerId], references: [id])
  reports           StaffProfile[] @relation("StaffReportsTo")

  @@index([department])
  @@index([employmentStatus])
  @@index([reportingManagerId])
  @@map("staff_profiles")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  displayName String
  description String?
  scope       RoleScope @default(DOMAIN)
  hierarchy   Int       @default(0)
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  module      String
  scope       PermissionScope @default(MODULE)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String
  roleId      String
  assignedBy  String?
  assignedAt  DateTime  @default(now())
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id            String        @id @default(uuid())
  token         String        @unique
  userId        String
  userAgent     String?
  ipAddress     String?
  loginProvider LoginProvider @default(LOCAL)
  expiresAt     DateTime
  lastActivityAt DateTime      @default(now())
  isRevoked     Boolean       @default(false)
  revokedAt     DateTime?
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  staffId       String?
  action        String
  module        String
  resource      String
  resourceId    String?
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  requestId     String?
  correlationId String?
  status        String   @default("SUCCESS")
  message       String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@index([staffId])
  @@index([status])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Category {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?
  icon          String?
  image         String?
  bannerImage   String?
  parentId      String?
  level         Int       @default(0)
  path          String    @default("")
  displayOrder  Int       @default(0)
  isFeatured    Boolean   @default(false)
  isVisible     Boolean   @default(true)
  isMenuVisible Boolean   @default(true)
  seoTitle      String?
  seoDescription String?
  seoKeywords   String?
  status        String    @default("ACTIVE")
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")

  attributeMappings CategoryAttribute[]
  productMappings   ProductCategory[]

  @@index([parentId])
  @@index([level])
  @@index([path])
  @@index([status])
  @@index([isFeatured])
  @@index([isVisible])
  @@index([isMenuVisible])
  @@index([deletedAt])
  @@index([displayOrder])
  @@map("categories")
}

model Brand {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?
  logo          String?
  bannerImage   String?
  website       String?
  isFeatured    Boolean   @default(false)
  isVisible     Boolean   @default(true)
  displayOrder  Int       @default(0)
  status        String    @default("ACTIVE")
  seoTitle      String?
  seoDescription String?
  seoKeywords   String?
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products Product[]

  @@index([deletedAt])
  @@index([status])
  @@index([isFeatured])
  @@index([isVisible])
  @@map("brands")
}

model AttributeGroup {
  id           String      @id @default(uuid())
  name         String
  slug         String      @unique
  description  String?
  displayOrder Int         @default(0)
  status       String      @default("ACTIVE")
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  attributes Attribute[]

  @@index([deletedAt])
  @@index([status])
  @@map("attribute_groups")
}

model Attribute {
  id            String      @id @default(uuid())
  groupId       String
  name          String
  slug          String
  type          String
  description   String?
  displayOrder  Int         @default(0)
  isRequired    Boolean     @default(false)
  isFilterable  Boolean     @default(false)
  isSearchable  Boolean     @default(false)
  isComparable  Boolean     @default(false)
  isVariant     Boolean     @default(false)
  status        String      @default("ACTIVE")
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  group            AttributeGroup    @relation(fields: [groupId], references: [id])
  options          AttributeOption[]
  categoryMappings CategoryAttribute[]
  productValues    ProductAttribute[]
  variantValues    VariantAttributeValue[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@index([type])
  @@index([status])
  @@index([deletedAt])
  @@map("attributes")
}

model AttributeOption {
  id           String   @id @default(uuid())
  attributeId  String
  value        String
  label        String
  metadata     Json?
  displayOrder Int      @default(0)
  status       String   @default("ACTIVE")
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attribute     Attribute              @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues VariantAttributeValue[]

  @@index([attributeId])
  @@index([value])
  @@index([deletedAt])
  @@map("attribute_options")
}

model CategoryAttribute {
  categoryId   String
  attributeId  String
  displayOrder Int      @default(0)
  isRequired   Boolean  @default(false)
  isFilterable Boolean  @default(false)
  isSearchable Boolean  @default(false)
  isComparable Boolean  @default(false)
  isVariant    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@index([categoryId])
  @@index([attributeId])
  @@map("category_attributes")
}

model Product {
  id                  String    @id @default(uuid())
  sku                 String    @unique
  barcode             String    @unique
  name                String
  slug                String    @unique
  shortDescription    String?
  description         String?
  brandId             String
  type                String    @default("READYMADE")
  status              String    @default("DRAFT")
  visibility          String    @default("VISIBLE")
  basePrice           Decimal
  salePrice           Decimal?
  wholesalePrice      Decimal?
  costPrice           Decimal?
  taxPercentage       Decimal?  @default(0)
  discountType        String?
  discountValue       Decimal?
  trackInventory      Boolean   @default(true)
  allowBackorder      Boolean   @default(false)
  minimumOrderQuantity Int      @default(1)
  maximumOrderQuantity Int      @default(0)
  weight              Decimal?
  length              Decimal?
  width               Decimal?
  height              Decimal?
  isFeatured          Boolean   @default(false)
  isNewArrival        Boolean   @default(false)
  isBestSeller        Boolean   @default(false)
  isPublished         Boolean   @default(false)
  publishedAt         DateTime?
  displayOrder        Int       @default(0)
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String?
  canonicalUrl        String?
  searchKeywords      String?
  gender              String?
  ageGroup            String?
  occasion            String?
  season              String?
  tags                String[]
  collections         String[]
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  brand          Brand                 @relation(fields: [brandId], references: [id])
  categories     ProductCategory[]
  attributeValues ProductAttribute[]
  variants       ProductVariant[]
  media          ProductMedia[]
  wishlistItems  WishlistItem[]
  cartItems      ShoppingCartItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  prescriptionMedicines PrescriptionMedicine[]
  customerRecommendations CustomerRecommendation[]
  relatedTo      ProductRelatedProduct[] @relation("ProductRelatedTo")
  relatedFrom    ProductRelatedProduct[] @relation("ProductRelatedFrom")

  @@index([brandId])
  @@index([status])
  @@index([visibility])
  @@index([type])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([isBestSeller])
  @@index([isPublished])
  @@index([gender])
  @@index([ageGroup])
  @@index([occasion])
  @@index([season])
  @@index([basePrice])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([isPublished, visibility, deletedAt])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductAttribute {
  productId   String
  attributeId String
  value       String?

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
  @@map("product_attributes")
}

model ProductRelatedProduct {
  productId        String
  relatedProductId String

  product        Product @relation("ProductRelatedTo", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelatedFrom", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([productId])
  @@index([relatedProductId])
  @@map("product_related_products")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model ProductVariant {
  id                String    @id @default(uuid())
  productId         String
  sku               String    @unique
  barcode           String    @unique
  title             String
  priceOverride     Decimal?
  salePriceOverride Decimal?
  costPrice         Decimal?
  weight            Decimal?
  length            Decimal?
  width             Decimal?
  height            Decimal?
  displayOrder      Int       @default(0)
  status            String    @default("ACTIVE")
  isDefault         Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  product          Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues  VariantAttributeValue[]
  inventory        Inventory?
  warehouseStock   VariantWarehouseInventory[]
  media            ProductMedia[]
  wishlistItems    WishlistItem[]
  cartItems        ShoppingCartItem[]
  orderItems       OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@index([status])
  @@index([isActive])
  @@index([isDefault])
  @@index([deletedAt])
  @@map("product_variants")
}

model VariantAttributeValue {
  id              String   @id @default(uuid())
  variantId       String
  attributeId     String
  attributeOptionId String?
  value           String?

  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    AttributeOption? @relation(fields: [attributeOptionId], references: [id], onDelete: SetNull)

  @@unique([variantId, attributeId])
  @@index([variantId])
  @@index([attributeId])
  @@index([attributeOptionId])
  @@map("variant_attribute_values")
}

model Inventory {
  id                 String   @id @default(uuid())
  variantId          String   @unique
  availableQuantity  Int      @default(0)
  reservedQuantity   Int      @default(0)
  damagedQuantity    Int      @default(0)
  returnedQuantity   Int      @default(0)
  minimumStock       Int      @default(0)
  maximumStock       Int      @default(0)
  reorderLevel       Int      @default(0)
  stockStatus        String   @default("OUT_OF_STOCK")
  allowBackorder     Boolean  @default(false)
  trackInventory     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  variant    ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements  InventoryMovement[]

  @@index([stockStatus])
  @@map("inventory")
}

model InventoryMovement {
  id              String   @id @default(uuid())
  inventoryId     String
  variantId       String
  movementType    String
  quantity        Int
  previousQuantity Int
  newQuantity     Int
  referenceType   String?
  referenceId     String?
  reason          String?
  remarks         String?
  performedBy     String?
  createdAt       DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([variantId])
  @@index([movementType])
  @@index([createdAt])
  @@map("inventory_movements")
}

model Warehouse {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  description   String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  contactPerson String?
  phone         String?
  email         String?
  status        String    @default("ACTIVE")
  isDefault     Boolean   @default(false)
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  locations   WarehouseLocation[]
  inventories VariantWarehouseInventory[]

  @@index([status])
  @@index([deletedAt])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String   @id @default(uuid())
  warehouseId String
  zone        String?
  rack        String?
  shelf       String?
  bin         String?
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@map("warehouse_locations")
}

model VariantWarehouseInventory {
  id                String   @id @default(uuid())
  warehouseId       String
  variantId         String
  availableQuantity Int      @default(0)
  reservedQuantity  Int      @default(0)
  damagedQuantity   Int      @default(0)
  minimumStock      Int      @default(0)
  maximumStock      Int      @default(0)
  reorderLevel      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
  @@index([warehouseId])
  @@index([variantId])
  @@map("variant_warehouse_inventory")
}

model ProductMedia {
  id           String    @id @default(uuid())
  productId    String
  variantId    String?
  mediaType    String
  title        String?
  altText      String?
  url          String
  thumbnailUrl String?
  displayOrder Int       @default(0)
  isPrimary    Boolean   @default(false)
  status       String    @default("ACTIVE")
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([mediaType])
  @@index([isPrimary])
  @@index([deletedAt])
  @@map("product_media")
}

model CustomerProfile {
  id                   String    @id @default(uuid())
  userId               String    @unique
  phone                String?
  gender               String?
  dateOfBirth          DateTime?
  preferredLanguage    String    @default("en")
  preferredCurrency    String    @default("INR")
  preferredCategories  String[]
  preferredBrands      String[]
  preferredSizes       String[]
  preferredColors      String[]
  preferredPriceMin    Decimal?
  preferredPriceMax    Decimal?
  profileImage         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses  CustomerAddress[]
  wishlists  Wishlist[]
  carts      ShoppingCart[]
  orders     Order[]
  wallet     Wallet?
  reviews    Review[]
  supportTickets SupportTicket[]
  customerRecommendations CustomerRecommendation[]

  @@index([userId])
  @@map("customer_profiles")
}

model CustomerAddress {
  id             String    @id @default(uuid())
  customerId     String
  label          String    @default("Home")
  fullName       String
  phone          String
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  country        String    @default("IN")
  postalCode     String
  landmark       String?
  latitude       Decimal?
  longitude      Decimal?
  isDefaultBilling  Boolean @default(false)
  isDefaultShipping Boolean @default(false)
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@map("customer_addresses")
}

model Wishlist {
  id         String    @id @default(uuid())
  customerId String
  name       String    @default("Default")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@index([customerId])
  @@map("wishlists")
}

model WishlistItem {
  id         String    @id @default(uuid())
  wishlistId String
  productId  String
  variantId  String?
  notes      String?
  createdAt  DateTime  @default(now())

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

model ShoppingCart {
  id         String    @id @default(uuid())
  customerId String?
  guestId    String?
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    ShoppingCartItem[]

  @@index([customerId])
  @@index([guestId])
  @@index([status])
  @@map("shopping_carts")
}

model ShoppingCartItem {
  id         String    @id @default(uuid())
  cartId     String
  productId  String
  variantId  String?
  quantity   Int       @default(1)
  unitPrice  Decimal
  totalPrice Decimal
  savedForLater Boolean @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  cart    ShoppingCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
