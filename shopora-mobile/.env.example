# Copy to `.env` and point at whichever backend this device should talk to.
# Expo inlines any EXPO_PUBLIC_* variable at build time, so restart the dev
# server (`npx expo start -c`) after changing it.

# Local backend, reachable from a phone on the same Wi-Fi.
# Use the laptop's LAN IP — "localhost" resolves to the phone itself.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:4000/api/v1

# UAT (Railway)
# EXPO_PUBLIC_API_BASE_URL=https://secure-quietude-production-afa9.up.railway.app/api/v1
